          "stringUnit" : {
            "state" : "translated",
            "value" : "더 적절한 건강 안내를 제공하는 데 사용됩니다. 확실하지 않다면 나중에 입력할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется для более подходящих пояснений о здоровье. Если вы не уверены, данные можно указать позже."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於提供更合適的健康說明；不確定時可以稍後填寫。"
          }
        }
      }
    },
    "用低负担动作换取连续性，让补水、日照、呼吸和起身慢慢长成习惯。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trade low-burden actions for continuity, letting hydration, daylight, breathing, and standing up slowly grow into habits."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misez sur des actions simples et régulières pour transformer progressivement hydratation, lumière, respiration et mouvement en habitudes."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부담이 적은 활동으로 꾸준함을 만들고 수분 섭취, 햇빛, 호흡 및 일어나기를 천천히 습관으로 만들어 보세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддерживайте регулярность простыми действиями, постепенно превращая воду, свет, дыхание и движение в привычки."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用低負擔動作換取連續性，讓補水、日照、呼吸和起身慢慢長成習慣。"
          }
        }
      }
    },
    "用最近 14 天健康样本做参考基线。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the past 14 days of health samples as the reference baseline."

        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用最近 14 天健康樣本做參考基線。"
          }
        }
      }
    },
    "用实时心率、HRV 与压力估计当前身体负荷" : {
      "localizations" : {

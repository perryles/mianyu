          }
        }
      }
    },
    "整体平稳" : {

    },
    "整体感受 %.1f/5" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overall feeling %.1f/5"

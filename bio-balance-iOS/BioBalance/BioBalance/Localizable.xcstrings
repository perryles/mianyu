    },
    "结合睡眠、活动与身体信号，为你整理真正值得关注的变化。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combine sleep, activity, and body signals to highlight the changes that truly matter."
          }
        },
        "fr" : {
          "stringUnit" : {

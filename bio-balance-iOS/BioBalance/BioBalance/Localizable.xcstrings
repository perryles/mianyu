    " " : {

    },
    " 正值卵泡期，状态回暖中，稳住节奏就能顺顺地往前推。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " You're in the follicular phase — energy's warming up, so a steady pace will carry you smoothly forward."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 正值卵泡期，狀態回暖中，穩住節奏就能順順地往前推。"
          }
        }
      }
    },
    " 正值排卵期，火力虽足，也记得留点恢复余量。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " You're in the ovulation phase — plenty of firepower, just remember to save some recovery margin."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 正值排卵期，火力雖足，也記得留點恢復餘量。"
          }
        }
      }
    },
    " 正值经期，今天请把舒服和休息排在第一位，其他都可以等等。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " You're on your period — comfort and rest come first today; everything else can wait."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 正值經期，今天請把舒服和休息排在第一位，其他都可以等等。"
          }
        }
      }
    },
    " 正值黄体期，后半天容易变敏感，对自己温柔一点。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " You're in the luteal phase — afternoons can feel extra sensitive, so be gentle with yourself."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 正值黃體期，後半天容易變敏感，對自己溫柔一點。"
          }
        }
      }
    },

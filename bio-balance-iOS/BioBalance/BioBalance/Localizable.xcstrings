    },
    "静息心率与趋势" : {

    },
    "静息心率中等，继续观察即可。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resting heart rate is moderate — just keep observing."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "靜息心率中等，繼續觀察即可。"
          }
        }
      }
    },
    "静息心率偏高，可能提示负荷抬升。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resting heart rate is high — possibly signaling rising load."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "靜息心率偏高，可能提示負荷抬升。"
          }
        }
      }
    },
    "静息心率和今天整体节奏比较接近，通常说明身体负荷还在相对平稳的范围里。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resting heart rate tracks today's overall pace closely, usually meaning bodily load is still in a relatively steady range."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "靜息心率和今天整體節奏比較接近，通常說明身體負荷還在相對平穩的範圍裡。"
          }
        }
      }
    },
    "静息心率已经更新，接下来更适合结合睡眠、HRV 和日内心率判断恢复情况。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resting heart rate has updated — next, judge recovery with sleep, HRV, and intraday heart rate together."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "靜息心率已經更新，接下來更適合結合睡眠、HRV 和日內心率判斷恢復情況。"
          }
        }
      }
    },
    "静息心率更适合按天或按周看变化，单次日内波动不代表静息水平本身发生了改变。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resting heart rate is better viewed by day or week; a single intraday fluctuation doesn't mean the resting level itself has changed."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "靜息心率更適合按天或按周看變化，單次日內波動不代表靜息水平本身發生了改變。"
          }
        }
      }
    },
    "静息心率更适合看日内负荷和长期趋势，持续抬高时再结合身体感受。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resting heart rate is best for intraday load and long-term trends — check how you feel when it keeps rising."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "靜息心率更適合看日內負荷和長期趨勢，持續抬高時再結合身體感受。"
          }
        }
      }
    },
    "静息心率更适合看连续几天有没有整体上移，而不是只看某一天高一点还是低一点。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resting heart rate is better for spotting whether several consecutive days shift upward overall, rather than whether a single day is slightly higher or lower."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "靜息心率更適合看連續幾天有沒有整體上移，而不是隻看某一天高一點還是低一點。"
          }
        }
      }
    },
    "静息心率较稳，对状态较友好。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resting heart rate is steady — friendly to your state."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "靜息心率較穩，對狀態較友好。"
          }
        }
      }
    },
    "静息时的能量消耗，不是每日总消耗" : {

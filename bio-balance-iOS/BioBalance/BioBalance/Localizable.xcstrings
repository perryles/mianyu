    "力量刺激更适合看一周内是否持续出现，长期空档通常比单次峰值更影响节律。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strength stimulus is best judged by whether it recurs within a week — long gaps usually affect rhythm more than a single peak."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "力量刺激更適合看一週內是否持續出現，長期空檔通常比單次峰值更影響節律。"
          }
        }
      }
    },
    "力量类训练优先关注训练负荷与恢复状态，距离和配速不作为核心表现指标。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strength training gives priority to training load and recovery status, and distance and pace are not used as core performance indicators."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "力量類訓練優先關注訓練負荷與恢復狀態，距離和配速不作為核心表現指標。"
          }
        }
      }
    },

    "HRV" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV"
          }
        }
      }
    },
    "HRV 低于个人恢复基线，且当前余量不算充足；今天把任务切短、减少连续输出会更稳。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV is below your personal recovery baseline and headroom is limited — today, shorter task blocks and less continuous output will be steadier."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV 低於個人恢復基線，且當前餘量不算充足；今天把任務切短、減少連續輸出會更穩。"
          }
        }
      }
    },
    "HRV 低于近期基线" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV below recent baseline"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV 低於近期基線"
          }
        }
      }
    },
    "HRV 低于近期基线，先用最轻的恢复动作把身体拉回来。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV is below your recent baseline — use the lightest recovery actions to pull your body back first."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV 低於近期基線，先用最輕的恢復動作把身體拉回來。"
          }
        }
      }
    },
    "HRV 压力自测" : {
      "extractionState" : "stale",
      "localizations" : {

    },
    "孕期设置、体重与胎动仅使用当前 Apple ID 的 CloudKit 私有数据库。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregnancy settings, weight, and fetal movement use only the current Apple ID's CloudKit private database."

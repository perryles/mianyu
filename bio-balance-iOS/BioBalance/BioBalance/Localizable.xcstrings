          }
        }
      }
    },
    "HRV 基线 / 夜间" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV baseline / night"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {

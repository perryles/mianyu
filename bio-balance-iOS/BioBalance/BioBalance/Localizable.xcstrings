    "先保护恢复窗口" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protect your recovery window first"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先保護恢復時段"
          }
        }
      }
    },
    "先保持数据同步，完整画像会说明缺少的样本或权限。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep your data syncing for now. The full profile will explain any missing samples or permissions."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先保持資料同步，完整畫像會說明缺少的樣本或許可權。"
          }
        }
      }
    },
    "先保持设备佩戴并同步健康数据，样本足够后会生成个性化建议。" : {

    },
    "先保持设备佩戴并完成一次健康数据同步，再回来查看这一周。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the device on and complete a health data synchronization, then check back this week."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先保持裝置佩戴並完成一次健康資料同步，再回來檢視這一週。"
          }
        }
      }
    },
    "先保证佩戴贴合和静止测量，再去判断数据本身是否异常。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensure a snug fit and still measurement first, then judge whether the data itself is abnormal."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先保證佩戴貼合和靜止測量，再去判斷資料本身是否異常。"
          }
        }
      }
    },
    "先保证月经开始日期记录连续，再结合最近几个月的平均节律去理解周期长度。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep period start dates logged consistently first, then interpret cycle length using the average rhythm of recent months."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先保證月經開始日期記錄連續，再結合最近幾個月的平均節律去理解週期長度。"
          }
        }
      }
    },
    "先保证连续有氧样本、稳定佩戴和完整心率记录，再观察后续几天到几周是否出现新的估算。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensure continuous aerobic samples, stable wearing, and complete heart-rate records, then watch for a new estimate over the following days to weeks."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先保證連續有氧樣本、穩定佩戴和完整心率記錄，再觀察後續幾天到幾周是否出現新的估算。"
          }
        }
      }
    },
    "先保频次再拉时长" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build Frequency Before Duration"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先保持頻次再增加時長"
          }
        }
      }
    },
    "先做一项低负担行动，不需要一次补齐全部目标。完成后会同步更新今日进度。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin with one low-effort action. You do not need to complete every goal at once; today's progress updates when you finish."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先做一項低負擔行動，不需要一次補齊全部目標。完成後會同步更新今日進度。"
          }
        }
      }
    },
    "先停止高强度活动，坐下休息 3-5 分钟；若伴随胸闷、头晕或持续不适，请及时就医。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop high-intensity activity first and sit down to rest for 3–5 minutes; if accompanied by chest tightness, dizziness, or persistent discomfort, seek medical help promptly."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先停止高強度活動，坐下休息 3-5 分鐘；若伴隨胸悶、頭暈或持續不適，請及時就醫。"
          }
        }
      }
    },
    "先创建一个目标" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a goal first"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先建立一個目標"
          }
        }
      }
    },
    "先创建目标，7 天洞察会在这里生成。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a goal first, and 7-day insights will be generated here."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先建立目標，7 天洞察會在這裡生成。"
          }
        }
      }
    },
    "先判断当前恢复松紧，再决定今天适合维持、观察还是放慢。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First gauge how tight your recovery is, then decide whether today is for maintaining, observing, or slowing down."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先判斷當前恢復鬆緊，再決定今天適合維持、觀察還是放慢。"
          }
        }
      }
    },
    "先别急着下结论" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't jump to conclusions"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先別急著下結論"
          }
        }
      }
    },
    "先回看最近一周的方向，再决定要不要放大某一天的数字。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the direction of the past week first, then decide whether to zoom in on a single day."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先回看最近一週的方向，再決定要不要放大某一天的數字。"
          }
        }
      }
    },
    "先回看最近一周的睡眠、活动和恢复，再判断这个偏高是不是持续现象。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review the past week's sleep, activity, and recovery first, then judge whether the high reading is persistent."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先回看最近一週的睡眠、活動和恢復，再判斷這個偏高是不是持續現象。"
          }
        }
      }
    },
    "先回看最近几个月整体节律，再判断这次延迟是偶发还是开始持续变化。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review the overall rhythm of recent months first, then decide whether this delay is occasional or a sustained change."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先回看最近幾個月整體節律，再判斷這次延遲是偶發還是開始持續變化。"
          }
        }
      }
    },

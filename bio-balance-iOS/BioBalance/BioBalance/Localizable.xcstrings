        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優先關注睡眠時長和質量"
          }
        }
      }
    },
    "优先减少高压连续时段，给白天插入短恢复。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioritize reducing continuous high-stress periods and insert short recoveries into the day."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優先減少高壓連續時段，給白天插入短恢復。"
          }
        }
      }
    },
    "优先回看这些日期的晚间收尾、咖啡因、任务密度和睡前刺激。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First review those dates' evening wind-down, caffeine, task density, and pre-sleep stimulation."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優先回看這些日期的晚間收尾、咖啡因、任務密度和睡前刺激。"
          }
        }
      }
    },
    "优先围绕睡眠窗口和压力高峰做调整，通常最容易影响评分。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioritize adjusting around your sleep window and stress peaks — these usually affect the score most."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優先圍繞睡眠視窗和壓力高峰做調整，通常最容易影響評分。"
          }
        }
      }
    },
    "优先固定今晚入睡窗口，减少临睡前刺激，并观察是否连续多晚中断。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioritize fixing tonight's sleep window, reduce pre-sleep stimulation, and watch for interruptions across consecutive nights."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優先固定今晚入睡視窗，減少臨睡前刺激，並觀察是否連續多晚中斷。"
          }
        }
      }
    },
    "优先固定睡眠窗口，不急着增加训练或工作强度。" : {
      "localizations" : {

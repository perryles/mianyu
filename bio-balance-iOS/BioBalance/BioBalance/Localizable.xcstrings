          }
        }
      }
    },
    "结合训练时长、动态消耗与恢复状态，观察本次节奏是否适合当前身体状态。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combine the training duration, dynamic consumption and recovery status to observe whether this rhythm is suitable for the current physical condition."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結合訓練時長、動態消耗與恢復狀態，觀察本次節奏是否適合當前身體狀態。"
          }
        }
      }
    },
    "结合评分、主睡眠时长、夜间心率、呼吸频率和体温变化，快速看昨夜恢复状态。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combining score, main sleep duration, nighttime heart rate, respiratory rate, and temperature change to quickly assess last night's recovery."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結合評分、主睡眠時長、夜間心率、呼吸頻率和體溫變化，快速看昨夜恢復狀態。"
          }
        }
      }
    },
    "结合距离、配速与近期训练量，观察耐力节奏是否稳定；设备没有写入的指标会保持为空。" : {
      "localizations" : {

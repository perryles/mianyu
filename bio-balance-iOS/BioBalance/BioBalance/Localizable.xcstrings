          }
        }
      }
    },
    "HRV 均值 %lld ms" : {

    },
    "HRV 基线" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV baseline"
          }
        },
        "zh-Hant" : {

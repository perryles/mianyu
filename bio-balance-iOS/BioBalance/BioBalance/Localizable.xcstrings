    },
    "用训练时长、距离和负荷观察输出节奏，并结合恢复分安排下一次训练。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observe the output rhythm using training duration, distance and load, and arrange the next training based on recovery points."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用訓練時長、距離和負荷觀察輸出節奏，並結合恢復分安排下一次訓練。"
          }
        }
      }
    },
    "用轻量分布先看最近一周更像日常维持、按需用药，还是补剂集中出现在某几天。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the lightweight distribution to see whether the past week looks like daily maintenance, as-needed medication, or supplements clustered on certain days."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用輕量分佈先看最近一週更像日常維持、按需用藥，還是補劑集中出現在某幾天。"
          }
        }
      }
    },
    "用这段时间的真实记录，快速看恢复高点、低点和整体节律。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {

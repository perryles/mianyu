    "升级啦" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Level Up"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "升級了"
          }
        }
      }
    },
    "午后以平稳输出为主，如果体感开始发紧，就先把节奏收一点。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep afternoon output steady; if your body starts feeling tight, rein the pace in a bit first."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "午後以平穩輸出為主，如果體感開始發緊，就先把節奏收一點。"
          }
        }
      }
    },
    "午后优先补一点自然光和轻步行，这比继续久坐更能稳住节律。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the afternoon, prioritize some natural light and light walking — it steadies your rhythm better than staying seated."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "午後優先補一點自然光和輕步行，這比繼續久坐更能穩住節律。"
          }
        }
      }
    },
    "午后别连续久坐太久，最好每 60 分钟左右起身一次，把紧绷感打断。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't sit too long in the afternoon — ideally stand up about every 60 minutes to break the tension."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "午後別連續久坐太久，最好每 60 分鐘左右起身一次，把緊繃感打斷。"
          }
        }
      }
    },
    "午后可以保持稳定推进，但训练和工作都只建议到中等负荷。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can keep advancing steadily in the afternoon, but keep both training and work at moderate load only."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "午後可以保持穩定推進，但訓練和工作都只建議到中等負荷。"
          }
        }
      }
    },
    "午后小卡顿？出去晒晒太阳或起身 %lld 分钟，给下半场重启一下。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Got stuck in the afternoon? Get out in the sun or get up for %lld minutes to give the second half a reboot."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "午後小卡頓？出去曬曬太陽或起身 %lld 分鐘，給下半場重啟一下。"
          }
        }
      }
    },
    "午后提醒" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afternoon reminder"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "午後提醒"
          }
        }
      }

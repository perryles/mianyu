        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先把恢復放回優先順序，再繼續硬撐會更累"
          }
        }
      }
    },
    "先把排卵日放进整个易孕窗口里理解，再结合连续记录判断自己的节律。" : {
      "localizations" : {
        "en" : {

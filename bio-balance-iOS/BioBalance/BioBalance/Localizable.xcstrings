    },
    "优先休息、补水、正常进食和轻走动，复杂任务与高强度输出尽量后移。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioritize rest, hydration, regular meals, and light walking; push complex tasks and high-intensity output later."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優先休息、補水、正常進食和輕走動，複雜任務與高強度輸出儘量後移。"
          }
        }
      }
    },
    "优先使用健康 App 中的本地睡眠记录" : {
      "extractionState" : "stale",

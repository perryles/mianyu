const COLOR_BACKGROUND = '#F4F7F5';
const COLOR_CARD = '#FFFFFFFF';
const COLOR_TEXT = '#17221D';
const COLOR_SECONDARY = '#68756E';
const COLOR_GREEN = '#1E8E63';

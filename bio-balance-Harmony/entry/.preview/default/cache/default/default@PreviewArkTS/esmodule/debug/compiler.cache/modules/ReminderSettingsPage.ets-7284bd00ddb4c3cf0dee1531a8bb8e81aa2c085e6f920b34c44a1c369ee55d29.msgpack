    async loadSettings() {
        const context = this.getUIContext().getHostContext();
        if (context === undefined) {
            this.statusText = this.t('reminder_storage_unavailable');
            this.loaded = true;
            return;
        }
        const list = [];
        for (let index = 0; index < REMINDER_PRESETS.length; index++) {
            const preset = REMINDER_PRESETS[index];
            const setting = await ReminderService.loadSetting(context, preset.key);
            list.push(setting);
        }
        this.settings = list;
        this.loaded = true;

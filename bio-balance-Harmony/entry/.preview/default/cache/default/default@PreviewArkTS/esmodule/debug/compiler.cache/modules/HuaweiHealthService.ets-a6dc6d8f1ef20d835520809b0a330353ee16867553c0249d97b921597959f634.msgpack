                let latestBpm = 0;
                let latestTime = 0;
                points.forEach((point) => {
                    if (HuaweiHealthService.localDate(new Date(point.startTime)) === key && point.modifiedTime >= latestTime) {
                        latestTime = point.modifiedTime;
                        latestBpm = point.fields.restBpm;
                    }

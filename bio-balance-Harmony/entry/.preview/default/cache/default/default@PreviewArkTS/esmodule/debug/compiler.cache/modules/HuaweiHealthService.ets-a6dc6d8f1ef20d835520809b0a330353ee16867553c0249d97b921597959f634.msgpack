     * 1=æ·±ç¡ 2=æµ…ç¡ 3=REM 4=æ¸…é†’ï¼›å…¶ä½™çŠ¶æ€ï¼ˆ0 æœªçŸ¥ã€5 å°ç¡ã€6 å§åºŠç­‰ï¼‰ä¸çº³å…¥åˆ†æœŸå æ¯”ã€‚
     */
    aggregateLatestSleepStages(records) {
        const empty = this.emptySleepStages();
        if (records.length === 0) {
            return empty;
        }
        const sorted = records.slice().sort((a, b) => b.startTime - a.startTime);
        for (let index = 0; index < sorted.length; index++) {
            const record = sorted[index];
            const segments = record.details?.sleepSegment;
            if (segments === undefined || segments.length === 0) {
                continue;
            }
            let deepMinutes = 0;
            let shallowMinutes = 0;
            let dreamMinutes = 0;
            let awakeMinutes = 0;
            let totalMinutes = 0;
            segments.forEach((segment) => {
                const minutes = Math.round((segment.endTime - segment.startTime) / 60000);
                if (minutes <= 0) {
                    return;
                }
                if (segment.sleepStatus === 1) {
                    deepMinutes += minutes;
                    totalMinutes += minutes;
                }
                else if (segment.sleepStatus === 2) {
                    shallowMinutes += minutes;
                    totalMinutes += minutes;
                }
                else if (segment.sleepStatus === 3) {
                    dreamMinutes += minutes;
                    totalMinutes += minutes;
                }
                else if (segment.sleepStatus === 4) {
                    awakeMinutes += minutes;
                }
            });
            return { deepMinutes, shallowMinutes, dreamMinutes, awakeMinutes, totalMinutes, hasDetails: totalMinutes > 0 };
        }
        return empty;
    }
    emptySleepStages() {
        return { deepMinutes: 0, shallowMinutes: 0, dreamMinutes: 0, awakeMinutes: 0, totalMinutes: 0, hasDetails: false };
    }
    containsRequiredTypes(grantedTypes) {
        const requiredIds = this.readDataTypes.map((type) => type.id);
        for (let index = 0; index < requiredIds.length; index++) {
            const found = grantedTypes.some((grantedType) => grantedType.id === requiredIds[index]);
            if (!found) {
                return false;
            }
        }
        return true;
    }
    containsAnyRequiredType(requiredTypes, grantedTypes) {
        return requiredTypes.some((requiredType) => grantedTypes.some((grantedType) => grantedType.id === requiredType.id));
    }
    /**
     * å°†å¥åº·æœåŠ¡é”™è¯¯ç æ˜ å°„ä¸ºç”¨æˆ·å¯è¯»æ–‡æ¡ˆï¼ˆä¸è¾“å‡ºä»»ä½•å¥åº·æ˜ç»†ï¼‰ã€‚
     */
    errorMessage(code) {
        switch (code) {
            case 201:
                return this.t('health_error_config');
            case 1002701001:
                return this.t('health_error_network');
            case 1002702001:
                return this.t('health_error_account');
            case 1002702002:
                return this.t('health_error_unavailable_format', code);
            case 1002703001:
                return this.t('health_error_privacy');
            case 1002700001:
            case 1002700002:
                return this.t('health_error_unavailable_format', code);
            default:
                return this.t('health_error_unavailable_format', code);
        }
    }
    static localDate(date) {
        const month = `${date.getMonth() + 1}`.padStart(2, '0');
        const day = `${date.getDate()}`.padStart(2, '0');
        return `${date.getFullYear()}-${month}-${day}`;
    }
}

 */
export interface SleepStages {
  deepMinutes: number;
  shallowMinutes: number;
  dreamMinutes: number;
  awakeMinutes: number;
  totalMinutes: number;
  hasDetails: boolean;
}

/**
 * ç¡çœ åˆ†æœŸæ˜ç»†æ®µï¼ˆHealth Service Kit çš„ sleepSegment å­é›†ï¼‰ã€‚

//# sourceMappingURL=PrivacyPage.js.mapÂÙj/Users/lihaha/Documents/o-company/bio-balance/bio-balance-Harmony/entry/src/main/ets/pages/PrivacyPage.etsÔrBšªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo°belongModulePath¬shouldEmitJs¥entryÃÂÙG/Users/lihaha/Documents/o-company/bio-balance/bio-balance-Harmony/entryÙA/Users/lihaha/Documents/o-company/bio-balance/bio-balance-Harmony¥entry¥1.0.0Ô␀␀ÙG/Users/lihaha/Documents/o-company/bio-balance/bio-balance-Harmony/entryÃÃÚÑ/**
 * éšç§ä¸æ•°æ®é¡µï¼ˆPEN-11ï¼‰ã€‚
 * å¯¹é½ iOS NSHealthShareUsageDescription çš„æƒé™ç”¨é€”è¯´æ˜ï¼Œå¹¶è¯´æ˜æœ¬æœºå­˜å‚¨ã€åªè¯»ä¸å†™ã€
 * äº‘å¤‡ä»½å£å¾„ä¸æœªæ¥äº‘åŒæ­¥ç™½åå•è¾¹ç•Œã€‚æ–‡æ¡ˆé›†ä¸­åœ¨ resources/base/element/string.jsonã€‚
 */
const COLOR_BACKGROUND: string = '#F4F7F5';
const COLOR_CARD: string = '#FFFFFFFF';
const COLOR_TEXT: string = '#17221D';
const COLOR_SECONDARY: string = '#68756E';
const COLOR_GREEN: string = '#1E8E63';

@Entry
@Component
struct PrivacyPage {
  @Builder
  SectionTitle(title: ResourceStr) {
    Text(title)
      .fontSize(15)
      .fontWeight(FontWeight.Bold)
      .fontColor(COLOR_SECONDARY)
      .width('100%')
  }

  @Builder
  BulletRow(icon: string, text: ResourceStr) {
    Row({ space: 10 }) {
      Text(icon)
        .fontSize(14)
        .fontColor(COLOR_GREEN)
        .width(22)
      Text(text)
        .fontSize(14)
        .fontColor(COLOR_TEXT)
        .lineHeight(21)
        .textAlign(TextAlign.Start)
        .layoutWeight(1)
    }
    .width('100%')
    .alignItems(VerticalAlign.Top)
  }

  @Builder
  BodyCard(body: ResourceStr) {
    Column({ space: 10 }) {
      Text(body)
        .fontSize(14)
        .fontColor(COLOR_TEXT)
        .lineHeight(22)
        .textAlign(TextAlign.Start)
        .width('100%')
    }
    .padding(17)
    .width('100%')
    .backgroundColor(COLOR_CARD)
    .borderRadius(22)
    .alignItems(HorizontalAlign.Start)
  }

  build() {
    Column() {
      Row({ space: 12 }) {
        Text('â€¹')
          .fontSize(28)
          .fontColor(COLOR_TEXT)
          .width(38)
          .height(38)
          .textAlign(TextAlign.Center)
          .onClick(() => this.getUIContext().getRouter().back())
        Column({ space: 3 }) {
          Text($r('app.string.privacy_page_title'))
            .fontSize(24)
            .fontWeight(FontWeight.Bold)
            .fontColor(COLOR_TEXT)
            .width('100%')
          Text($r('app.string.privacy_page_subtitle'))
            .fontSize(13)
            .fontColor(COLOR_SECONDARY)
            .width('100%')
        }
        .layoutWeight(1)
        .alignItems(HorizontalAlign.Start)
      }
      .width('100%')
      .padding({ left: 18, right: 18, top: 18, bottom: 12 })

      Scroll() {
        Column({ space: 20 }) {
          this.SectionTitle($r('app.string.privacy_section_permission'))
          this.BodyCard($r('app.string.privacy_permission_body'))

          this.SectionTitle($r('app.string.privacy_section_scope'))
          Column({ space: 12 }) {
            this.BulletRow('âœ“', $r('app.string.privacy_scope_steps'))
            this.BulletRow('âœ“', $r('app.string.privacy_scope_heart'))
            this.BulletRow('âœ“', $r('app.string.privacy_scope_sleep'))
          }
          .padding(17)
          .width('100%')
          .backgroundColor(COLOR_CARD)
          .borderRadius(22)
          .alignItems(HorizontalAlign.Start)

          this.SectionTitle($r('app.string.privacy_section_boundary'))
          Column({ space: 12 }) {
            this.BulletRow('âœ“', $r('app.string.privacy_boundary_readonly'))
            this.BulletRow('âœ“', $r('app.string.privacy_boundary_local'))
            this.BulletRow('âœ“', $r('app.string.privacy_boundary_backup'))
            this.BulletRow('âœ“', $r('app.string.privacy_boundary_sync'))
          }
          .padding(17)
          .width('100%')
          .backgroundColor(COLOR_CARD)
          .borderRadius(22)
          .alignItems(HorizontalAlign.Start)

          this.SectionTitle($r('app.string.privacy_section_revoke'))
          this.BodyCard($r('app.string.privacy_revoke_body'))

          this.SectionTitle($r('app.string.privacy_section_disclaimer'))
          this.BodyCard($r('app.string.privacy_disclaimer_body'))
        }
        .padding({ left: 18, right: 18, top: 8, bottom: 40 })
        .width('100%')
      }
      .scrollBar(BarState.Off)
      .width('100%')
      .layoutWeight(1)
    }
    .width('100%')
    .height('100%')
    .backgroundColor(COLOR_BACKGROUND)
  }
}

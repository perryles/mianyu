import type common from '@ohos.app.ability.common';
import { CloudAccountSnapshot, CloudAccountStatePolicy } from '../model/CloudAccountState';
import { CloudOutbox, CloudOutboxItem } from '../model/CloudOutbox';
import { CloudCursor, CloudRecord, CloudSyncPolicy } from '../model/CloudSyncContract';
import { CloudPullResult } from './CloudSyncTransport';

const STORAGE_NAME: string = 'bio_balance_cloud_sync';

export class CloudStateMutex {
  private tail: Promise<void> = Promise.resolve();

  async run<T>(operation: () => Promise<T>): Promise<T> {
    const previous: Promise<void> = this.tail;
    let release: () => void = (): void => {};

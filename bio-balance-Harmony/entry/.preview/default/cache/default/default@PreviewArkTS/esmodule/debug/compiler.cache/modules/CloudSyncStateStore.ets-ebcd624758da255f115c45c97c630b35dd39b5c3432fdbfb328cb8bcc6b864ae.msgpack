    store.putSync('accountId', value.accountId); store.putSync('generation', value.generation);
    store.putSync('enabled', value.enabled); store.putSync('cursorRevision', value.cursorRevision);
    store.putSync('cursorRecordId', value.cursorRecordId); store.putSync('logicalClock', value.logicalClock);
    store.putSync('records', value.recordsJson); store.putSync('outbox', value.outboxJson);
